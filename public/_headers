# ── Service worker ──────────────────────────────────────────────────────────
# Never cache. This file gates every update: a stale copy means the browser
# cannot tell that a new build exists at all.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# ── App shell ───────────────────────────────────────────────────────────────
# index.html names the content-hashed bundles, so a stale copy pins the whole
# app to an old build. Netlify already defaults HTML to max-age=0,
# must-revalidate — these make it explicit and survive a default change.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# ── Web app manifest ────────────────────────────────────────────────────────
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# ── Build output ────────────────────────────────────────────────────────────
# Vite fingerprints these filenames, so the content behind a given URL never
# changes. Netlify's default (max-age=0) makes browsers revalidate every chunk
# on every load, which is pure latency for immutable files.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Security headers (every path) ───────────────────────────────────────────
# These header names never appear in the rules above, so the cache rules stay on
# disjoint paths as intended. The CSP is REPORT-ONLY: violations show in the
# browser console (and in Sentry once its report-uri is added) and it becomes
# enforcing only after a clean week. connect-src lists the dev, QA and production
# API hosts because this file ships to every site. Same-origin framing stays
# allowed (print previews); the microphone is the voice-costing recorder and
# fullscreen the Virtual Factory.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self), fullscreen=(self)
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.pantone.com; connect-src 'self' https://api.avarshai.com https://apiqa.avarshai.com https://sristi.avarshai.com https://api.sristi.app https://i8k09r4vbf.execute-api.us-east-1.amazonaws.com https://api.postalpincode.in https://api.zippopotam.us https://open.er-api.com; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
