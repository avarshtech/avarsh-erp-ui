{
  "name": "erp-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev-local": "vite --host --mode local",
    "dev:e2e": "vite --mode e2e",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "E2E_HEADED=true npx playwright test --headed",
    "test:e2e:master": "npx playwright test --project=master-data",
    "test:e2e:costing": "npx playwright test --project=costing",
    "test:e2e:orders": "npx playwright test --project=orders",
    "test:e2e:bom": "npx playwright test --project=bom",
    "test:e2e:po": "npx playwright test --project=po",
    "test:e2e:production-po": "npx playwright test --project=production-po",
    "test:e2e:work-orders": "npx playwright test --project=work-orders",
    "test:e2e:admin": "npx playwright test --project=admin",
    "test:e2e:validation": "npx playwright test --project=validation",
    "test:e2e:legacy": "npx playwright test --project=legacy",
    "test:e2e:grn-qc": "npx playwright test --project=grn-qc"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.2.2",
    "axios": "^1.13.4",
    "dayjs": "^1.11.19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
