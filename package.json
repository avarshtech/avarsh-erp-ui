{
  "name": "erp-dashboard",
  "private": true,
  "version": "1.10.15",
  "type": "module",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev-local": "vite --host --mode local",
    "dev:e2e": "vite --mode e2e",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "lint": "eslint . --max-warnings 76",
    "lint:prune": "eslint . --prune-suppressions",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:master": "npx playwright test --project=master-data",
    "test:e2e:costing": "npx playwright test --project=costing",
    "test:e2e:orders": "npx playwright test --project=orders",
    "test:e2e:bom": "npx playwright test --project=bom",
    "test:e2e:po": "npx playwright test --project=po",
    "test:e2e:production-po": "npx playwright test --project=production-po",
    "test:e2e:work-orders": "npx playwright test --project=production-po --grep \"Work Order\"",
    "test:e2e:admin": "npx playwright test --project=admin",
    "test:e2e:validation": "npx playwright test --project=validation",
    "test:e2e:legacy": "npx playwright test --project=legacy",
    "test:e2e:grn-qc": "npx playwright test --project=grn-qc",
    "test:e2e:journey": "npx playwright test --project=journey",
    "test:e2e:approvals": "playwright test --project=approvals",
    "test:e2e:inventory": "playwright test --project=inventory",
    "test:e2e:sample-requests": "playwright test --project=sample-requests",
    "test:e2e:reports": "playwright test --project=reports",
    "test:e2e:branch": "playwright test --project=branch"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@react-three/fiber": "^9.8.1",
    "@sentry/react": "^10.75.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "antd": "^6.2.2",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
