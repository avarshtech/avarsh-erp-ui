# Tool caches and local tool state (.sentryclirc can hold an auth token;
# .claude/worktrees and .kilo hold other sessions' full checkouts)
.eslintcache
.stylelintcache
.netlify/
.sentryclirc
.claude/settings.local.json
.claude/worktrees/
.playwright-mcp/
.kilo/

# docs/ holds the confidential tester pack, which stays on this machine.
# Only docs/engineering/ (the UI standard, scorecard and review register) is tracked.
/docs/*
!/docs/engineering/
